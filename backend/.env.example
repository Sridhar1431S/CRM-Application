# Django
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Database
POSTGRES_DB=crm_lite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# API docs are served only when this is enabled (defaults to DJANGO_DEBUG)
EXPOSE_API_DOCS=true

# Demo seed data (management command refuses to run outside DEBUG without ALLOW_DEMO_SEED)
DEMO_ADMIN_PASSWORD=
DEMO_REP_PASSWORD=
